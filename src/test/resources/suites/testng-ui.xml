<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="UI Test Suite" parallel="classes" thread-count="2" verbose="1">

    <listeners>
        <listener class-name="com.automation.listeners.TestListener"/>
        <listener class-name="com.automation.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="UI Tests">
        <classes>
            <class name="com.automation.tests.ui.LoginTest"/>
            <class name="com.automation.tests.ui.ProductsTest"/>
            <class name="com.automation.tests.ui.CarWaleTest"/>
        </classes>
    </test>

</suite>
